{
  "datasets": [
    {
      "name": "injuries",
      "displayName": "OSHA injury facts",
      "queryLines": [
        "SELECT event_date, event_year, coding_era, state, industry_sector, event_category, nature_category,\n",
        "  body_part_category, source_category, hospitalized,\n",
        "  CASE WHEN nature_category IN ('Fracture', 'Amputation', 'Unspecified', 'Cut or puncture', 'Burn',\n",
        "    'Concussion or brain injury', 'Sprain, strain or bruise', 'Heat illness', 'Crushing injury')\n",
        "    THEN nature_category ELSE 'Other injury types' END AS nature_group,\n",
        "  CASE WHEN amputation > 0 THEN 1 ELSE 0 END AS amputation_report,\n",
        "  CASE WHEN loss_of_eye > 0 THEN 1 ELSE 0 END AS loss_of_eye_report\n",
        "FROM gold.osha_injury_facts"
      ]
    }
  ],
