{
  "datasets": [
    {
      "name": "fleet_kpis",
      "displayName": "Fleet KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT count(*) FROM gold.cmapss_fleet_status) AS engines,\n",
        "  (SELECT count_if(risk_band = 'critical') FROM gold.cmapss_fleet_status) AS critical_engines,\n",
        "  (SELECT count_if(risk_band = 'warning') FROM gold.cmapss_fleet_status) AS warning_engines,\n",
        "  (SELECT max(model_version) FROM gold.cmapss_fleet_status) AS champion_version,\n",
        "  (SELECT max_by(rmse, computed_at) FROM gold.cmapss_model_performance\n",
        "    WHERE segment = 'endpoint' AND model_version = (SELECT max(model_version) FROM gold.cmapss_fleet_status)) AS endpoint_rmse,\n",
        "  (SELECT count_if(breached) FROM gold.cmapss_alerts\n",
        "    WHERE alert_job_run = (SELECT max_by(alert_job_run, checked_at) FROM gold.cmapss_alerts)) AS latest_breaches"
      ]
    },
    {
      "name": "fleet_status",
      "displayName": "Fleet status",
      "queryLines": [
        "SELECT unit, last_cycle, round(predicted_rul, 1) AS predicted_rul, risk_band,\n",
        "  CASE risk_band WHEN 'critical' THEN '1 critical (<= 20)' WHEN 'warning' THEN '2 warning (21-50)'\n",
        "    ELSE '3 healthy (> 50)' END AS risk_label,\n",
        "  actual_rul, model_version\n",
        "FROM gold.cmapss_fleet_status\n",
        "ORDER BY predicted_rul, unit"
      ]
    },
    {
      "name": "at_risk_trajectories",
      "displayName": "Predicted RUL of the five most at-risk engines",
      "queryLines": [
        "WITH at_risk AS (\n",
        "  SELECT unit FROM gold.cmapss_fleet_status ORDER BY predicted_rul, unit LIMIT 5)\n",
        "SELECT concat('Engine ', lpad(CAST(p.unit AS STRING), 3, '0')) AS engine, p.cycle, p.predicted_rul\n",
        "FROM gold.cmapss_predictions p JOIN at_risk USING (unit)\n",
        "WHERE p.model_version = (SELECT max(model_version) FROM gold.cmapss_fleet_status) AND p.subset = 'FD001' AND p.split = 'test'"
      ]
    },
    {
      "name": "latest_performance",
      "displayName": "Latest performance snapshot",
      "queryLines": [
        "SELECT segment, rows, round(rmse, 2) AS rmse, round(mae, 2) AS mae, round(bias, 2) AS bias, model_version, computed_at,\n",
        "  CASE segment WHEN 'endpoint' THEN 1 WHEN 'actual_le_125' THEN 2 WHEN 'all' THEN 3 ELSE 4 END AS segment_order\n",
        "FROM gold.cmapss_model_performance\n",
        "WHERE model_version = (SELECT max(model_version) FROM gold.cmapss_fleet_status)\n",
        "  AND computed_at = (SELECT max(computed_at) FROM gold.cmapss_model_performance WHERE model_version = (SELECT max(model_version) FROM gold.cmapss_fleet_status))\n",
        "ORDER BY segment_order, segment"
      ]
    },
    {
      "name": "latest_drift",
      "displayName": "Latest drift snapshot",
      "queryLines": [
        "SELECT feature, round(psi, 3) AS raw_psi, round(psi_age_matched, 3) AS psi_age_matched, computed_at\n",
        "FROM gold.cmapss_feature_drift\n",
        "WHERE computed_at = (SELECT max(computed_at) FROM gold.cmapss_feature_drift)\n",
        "ORDER BY psi_age_matched DESC"
      ]
    },
    {
      "name": "alert_runs",
      "displayName": "Alert runs",
      "queryLines": [
        "SELECT alert_job_run, min(checked_at) AS checked_at, max(model_version) AS model_version, count(*) AS checks,\n",
        "  count_if(breached) AS breaches,\n",
        "  max(CASE WHEN `check` = 'psi_age_matched' THEN threshold END) AS psi_threshold,\n",
        "  max(CASE WHEN `check` = 'rmse_increase' THEN threshold END) AS rmse_increase_threshold\n",
        "FROM gold.cmapss_alerts\n",
        "GROUP BY alert_job_run\n",
        "ORDER BY checked_at DESC"
      ]
    }
  ],
